# HubSpot App
HUBSPOT_CLIENT_ID=your-client-id
HUBSPOT_CLIENT_SECRET=your-client-secret
HUBSPOT_APP_WEBHOOK_SECRET=your-webhook-secret
HUBSPOT_APP_ID=your-numeric-app-id

# GCP
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
CLOUD_TASKS_QUEUE=webhook-processing
SERVICE_ACCOUNT_EMAIL=inbox-agent@your-project.iam.gserviceaccount.com

# Cloud Run (set to your deployed URL in prod, http://localhost:8080 for local)
SERVICE_URL=https://inbox-agent-xxxx-uc.a.run.app

# AI Provider: "claude" (default) or "gemini"
AI_PROVIDER=claude

# Anthropic (required when AI_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-...

# Red Anthos (account-first onboarding — handoff JWT + Stripe customer source of truth)
# Base URL of the Red Anthos account service. JWKS, login page, and §3 lookup hang off this.
REDANTHOS_BASE_URL=https://redanthos.com
# Static service-to-service key for the Stripe-customer lookup (§3). Shared out-of-band.
REDANTHOS_API_KEY=
# Handoff JWT issuer/audience to verify (defaults: REDANTHOS_BASE_URL / "leadcatch").
REDANTHOS_JWT_ISSUER=https://redanthos.com
REDANTHOS_JWT_AUDIENCE=leadcatch

# Server
PORT=8080
